if (global.estado_jogo == "MENU"){
	var _cima = keyboard_check_pressed(vk_up) or keyboard_check(ord("W"));
	var _baixo = keyboard_check_pressed(vk_down) or keyboard_check(ord("S"));
	var _esq = keyboard_check_pressed(vk_left) or keyboard_check(ord("A"));
	var _dir = keyboard_check_pressed(vk_right) or keyboard_check(ord("D"));

}
	